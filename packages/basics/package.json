    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@slidesend/core": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "zod": "^4.6.5",
    "@types/qrcode": "^1.5.5",
    "react-dom": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "homepage": "https://github.com/nxsflow/slidesend/tree/main/packages/basics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxsflow/slidesend.git",
    "directory": "packages/basics"
  },
  "bugs": {
    "url": "https://github.com/nxsflow/slidesend/issues"
  },
  "keywords": [
    "slidesend",
