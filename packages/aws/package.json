{
  "name": "@slidesend/aws",
  "version": "0.1.0",
  "description": "Hosting for Slidesend talks on AWS: the backend on AWS Blocks, deploy, bootstrap with OIDC, and the GitHub Actions workflow.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json",
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./infra": {
      "types": "./dist/infra.d.ts",
      "import": "./dist/infra.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --project tsconfig.json"
  },
  "peerDependencies": {
    "@aws-blocks/blocks": "^0.6.0",
    "@slidesend/core": "workspace:^",
    "zod": "^4.0.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-blocks/blocks": "0.6.0",
    "@slidesend/core": "workspace:*",
    "@types/node": "^24.0.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    }
  },
  "homepage": "https://github.com/nxsflow/slidesend/tree/main/packages/aws#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxsflow/slidesend.git",
    "directory": "packages/aws"
  },
  "bugs": {
    "url": "https://github.com/nxsflow/slidesend/issues"
  },
  "keywords": [
    "slidesend",
    "presentation",
    "slides",
    "audience",
    "talk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
