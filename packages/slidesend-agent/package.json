{
  "name": "@nxsflow/slidesend-agent",
  "version": "0.0.0",
  "description": "The agent chat activity for Slidesend: phone UI plus a server half.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
