  },
  "devDependencies": {
    "@nxsflow/slidesend-core": "workspace:*",
    "react": "^19.3.0",
    "@types/react": "^19.3.0",
    "zod": "^4.6.5",
    "vitest": "^5.0.1",
    "@types/node": "^24.0.0",
    "@aws-blocks/blocks": "0.6.0"
  }
}
